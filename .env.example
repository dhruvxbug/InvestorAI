# ──────────────────────────────────────────────────────────
# InvestorAI — Environment Variables
# Copy this file to .env and fill in your keys.
# You only need ONE LLM key to run the system.
# ──────────────────────────────────────────────────────────

# ── LLM Provider Selection ────────────────────────────────
# Which provider to use: anthropic | openrouter | openai
# Leave blank to auto-detect from whichever key is present.
LLM_PROVIDER=

# Model ID to use (optional — uses provider default if blank)
# Examples:
#   claude-sonnet-4-20250514          (Anthropic)
#   anthropic/claude-sonnet-4         (OpenRouter)
#   openai/gpt-4o                     (OpenRouter)
#   meta-llama/llama-3.3-70b-instruct (OpenRouter)
#   gpt-4o                            (OpenAI)
LLM_MODEL=

# ── API Keys (add whichever you have) ────────────────────
# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenRouter — https://openrouter.ai/keys
# Gives access to 200+ models (Claude, GPT-4, Gemini, Llama, DeepSeek, Mistral…)
OPENROUTER_API_KEY=your_openrouter_key_here

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# ── News & Sentiment ──────────────────────────────────────
# Exa.ai — https://exa.ai/  (required for news/sentiment agents)
EXA_API_KEY=your_exa_key_here

# ── Optional ──────────────────────────────────────────────
# Default exchange suffix: .NS (NSE) or .BO (BSE)
DEFAULT_EXCHANGE=.NS
